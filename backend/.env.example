# Copie este arquivo para "backend/.env" e ajuste os valores.
# O Fluxy le o .env sozinho ao iniciar.

# Conexao com o PostgreSQL (tem prioridade sobre PGHOST/PGUSER/... abaixo)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fluxy_db

# Opcional: variaveis separadas, usadas se DATABASE_URL nao for definida
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=fluxy_db

# "true" para bancos hospedados que exigem SSL (Neon, Render, Supabase)
DATABASE_SSL=false

# Porta/host locais (em hospedagens como o Render, PORT e definido sozinho)
API_HOST=127.0.0.1
API_PORT=8080

# Origens que podem chamar a API pelo navegador, separadas por virgula.
# Ex.: https://seu-usuario.github.io   (vazio = qualquer origem)
CORS_ORIGINS=
